    "case":{"type":"object","additionalProperties":false,"required":["id","required","passed","score_mean","score_variance","runs","tags"],"properties":{"id":{"type":"string"},"required":{"type":"boolean"},"passed":{"type":"boolean"},"score_mean":{"type":"number"},"score_variance":{"type":"number","minimum":0},"runs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/run"}},"tags":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "pending":{"type":"object","additionalProperties":false,"required":["id","reason","tags"],"properties":{"id":{"type":"string"},"reason":{"const":"integration_pending"},"tags":{"type":"array","items":{"type":"string"}}}},
