    "judge":{"type":["object","null"],"properties":{"model":{"type":"string"},"prompt_version":{"type":"string"},"latency_ms":{"type":"number","minimum":0},"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0}},"required":["model","prompt_version","latency_ms","input_tokens","output_tokens"],"additionalProperties":false},
    "execution":{"type":"object","additionalProperties":false,"required":["raw_production_output","raw_schema_validation","normalized_observation","normalization_errors"],"properties":{"raw_production_output":{},"raw_schema_validation":{"type":"object","additionalProperties":false,"required":["passed","detail"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"}}},"normalized_observation":{"type":"object"},"normalization_errors":{"type":"array","items":{"type":"string"}}}},
