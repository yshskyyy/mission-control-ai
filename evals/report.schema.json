{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "check":{"type":"object","additionalProperties":false,"required":["name","passed","score","detail","grader_type"],"properties":{"name":{"type":"string","minLength":1},"passed":{"type":"boolean"},"score":{"type":"number"},"detail":{"type":"string"},"grader_type":{"enum":["rule","llm_judge"]}}},
